<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>OpenCamInterop.EventLab</RootNamespace>
    <Version>0.1.0-alpha.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\OpenCamInterop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\fixtures\**\*"
          Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\schemas\**\*"
          Link="schemas\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE"
          Link="LICENSE"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\README.md"
          Link="README.md"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD_PARTY_NOTICES.md"
          Link="THIRD_PARTY_NOTICES.md"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
